---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import BaseLayout from "@/layouts/BaseLayout.astro";
import RelatedApps from "@/components/RelatedApps.astro";
import SeoPost from "@/components/SeoPost.astro";
import Tag from "@/components/Tag.astro";

interface Props {
  app: CollectionEntry<"apps">;
}

export async function getStaticPaths() {
  const apps = await getCollection("apps");
  return apps.map((app) => ({
    params: { id: app.id },
    props: { app },
  }));
}

const { app } = Astro.props;
const { Content } = await render(app);
const tags = app.data.tags ?? [];
---

<BaseLayout>
  <SeoPost slot="head" entry={app} />
  <div>
    <div class="flex items-center gap-4 pt-12 sm:pt-16">
      <Image
        src={app.data.icon}
        width={100}
        height={100}
        quality="medium"
        format="webp"
        alt={app.data.title}
        loading="eager"
        class="size-24"
        transition:name={`${app.data.title}-icon`}
      />
      <div class="grid sm:gap-1">
        <h1
          class="flex items-center gap-1.5 text-2xl font-semibold sm:text-4xl"
          transition:name={`${app.data.title}-title`}
        >
          <a
            href={app.data.link}
            class="hover:underline"
            target="_blank"
            rel="noopener noreferrer">{app.data.title}</a
          >
          <Icon
            name="external-link"
            class="text-lightModeForegroundMuted dark:text-darkModeForegroundMuted size-4 sm:size-6"
          />
        </h1>
        <p
          class="text-lightModeForegroundMuted dark:text-darkModeForegroundMuted sm:text-base"
          transition:name={`${app.data.title}-mutedText`}
        >
          {app.data.developerName}
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2 pt-6">
      {
        app.data.isOpenSource ? (
          <Tag href="/isOpenSource">
            <span class="text-base text-green-500">●</span>
            Open Source
          </Tag>
        ) : null
      }
      {
        app.data.isFree ? (
          <Tag href="/isFree">
            <span class="text-base text-blue-500">■</span>
            Free
          </Tag>
        ) : null
      }
      {
        app.data.isOneTimePurchase ? (
          <Tag href="/isOneTimePurchase">
            <span class="text-base text-yellow-500">▲</span>
            One-Time Purchase
          </Tag>
        ) : null
      }
      {
        app.data.isSubscription ? (
          <Tag href="/isSubscription">
            <span class="text-base text-red-500">✖</span>
            Subscription
          </Tag>
        ) : null
      }
      {
        tags.map((tag) => (
          <Tag href={`/tags/${tag}`}>
            {tag}
          </Tag>
        ))
      }
    </div>

    <div class="py-4 sm:py-6"></div>

    <hr class="mb-8 opacity-25" />

    <div class="flex flex-col gap-12 lg:flex-row">
      <div class="min-w-0 flex-1">
        <div class="content prose dark:prose-invert">
          <Content />
        </div>
      </div>

      <div class="w-full shrink-0 lg:w-96">
        <RelatedApps app={app} />
      </div>
    </div>
  </div>
</BaseLayout>
