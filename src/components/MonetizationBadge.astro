---
import { type CollectionEntry } from "astro:content";

interface Props {
  app: CollectionEntry<"apps">;
}

const { app } = Astro.props;
---

<div
  class="mr-6 rounded-full bg-gray-200 px-4 py-1.5 text-xs font-semibold capitalize text-blue-500 md:mr-3 dark:bg-white"
>
  {app.data.monetization}
</div>
