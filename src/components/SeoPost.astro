---
import { type CollectionEntry } from "astro:content";
import { SITE } from "@/siteConfig";

interface Props {
  entry: CollectionEntry<"apps"> | CollectionEntry<"blog">;
}

const { entry } = Astro.props;

const postTitle = entry.data.title || SITE.title;
const postDescription =
  "tagline" in entry.data
    ? entry.data.tagline
    : "description" in entry.data
      ? entry.data.description
      : SITE.description;
const ogImage = new URL("./og.jpg", Astro.site);
---

<title>{`${postTitle} | ${SITE.title}`}</title>
<meta name="title" content={`${postTitle} | ${SITE.title}`} />
<meta name="description" content={postDescription} />
<link rel="canonical" href={new URL(Astro.url.pathname, SITE.url)} />

<meta property="og:title" content={postTitle} />
<meta property="og:description" content={postDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={postTitle} />
<meta property="og:type" content="website" />
<meta property="og:locale" content={SITE.locale} />

<meta name="twitter:title" content={postTitle} />
<meta name="twitter:description" content={postDescription} />
<meta property="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={postTitle} />
<meta name="twitter:card" content="summary_large_image" />

{
  "tags" in entry.data &&
    entry.data.tags &&
    entry.data.tags.map((tag: string) => {
      return <meta property="article:tag" content={tag} />;
    })
}
